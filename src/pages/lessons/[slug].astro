---
import { getCollection, render } from 'astro:content';
import LessonLayout from '@/layouts/LessonLayout.astro';
import { withBase } from '@/config/site';
import { orderLessons } from '@/lib/lessonOrder';

export async function getStaticPaths() {
  const all = await getCollection('lessons');
  const sorted = orderLessons(all);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: sorted[i + 1] ?? null, total: sorted.length },
  }));
}

const { entry, next, total } = Astro.props;
const { Content } = await render(entry);
const nextHref = next ? withBase('lessons/' + next.id) : undefined;
---
<LessonLayout
  slug={entry.id}
  title={entry.data.title}
  description={entry.data.summary}
  totalLessons={total}
  nextHref={nextHref}
  nextTitle={next?.data.title}
>
  <Content />
</LessonLayout>
