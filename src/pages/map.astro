---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/config/site';

const tierOrder: Record<string, number> = { basic: 0, intermediate: 1, expert: 2, applied: 3 };
const all = await getCollection('lessons');
const lessons = all.sort(
  (a, b) => (tierOrder[a.data.tier] - tierOrder[b.data.tier]) || a.data.order - b.data.order
);

const ids = new Set(lessons.map((l) => l.id));
const byId = new Map(lessons.map((l) => [l.id, l]));
// Only count prerequisites that actually exist in the collection.
const prereqsOf = (id: string) => (byId.get(id)?.data.prereqs ?? []).filter((p) => ids.has(p));

// Longest-path depth over the prerequisite DAG gives each lesson its layer.
const layerCache = new Map<string, number>();
function layerOf(id: string, seen = new Set<string>()): number {
  if (layerCache.has(id)) return layerCache.get(id) as number;
  if (seen.has(id)) return 0; // cycle guard; the graph is acyclic in practice
  seen.add(id);
  const ps = prereqsOf(id);
  const depth = ps.length === 0 ? 0 : 1 + Math.max(...ps.map((p) => layerOf(p, seen)));
  layerCache.set(id, depth);
  return depth;
}

const globalIndex = new Map(lessons.map((l, i) => [l.id, i]));
interface Node { id: string; title: string; order: number; label: string; layer: number; x: number; y: number; tier: string; prereqs: string[]; }

const layered = new Map<number, string[]>();
for (const l of lessons) {
  const ly = layerOf(l.id);
  if (!layered.has(ly)) layered.set(ly, []);
  (layered.get(ly) as string[]).push(l.id);
}

const yTop = 34, R = 15, xGap = 48, rowGap = 44, layerGap = 40;
const layerKeys = [...layered.keys()].sort((a, b) => a - b);
const widest = Math.max(...layerKeys.map((ly) => (layered.get(ly) as string[]).length));
// Keep the canvas narrow enough to read: cap the columns and wrap wide layers
// onto extra rows instead of stretching them into one long line.
const maxCols = 11;
const usedCols = Math.min(maxCols, widest);
const VBW = Math.max(360, usedCols * xGap + xGap);
const cx = VBW / 2;

// Place layers top-down. Within each layer, order nodes by the average x of
// their prerequisites (barycenter) so children sit under their parents, which
// cuts down edge crossings. Layers wider than maxCols wrap onto stacked rows.
const nodes: Node[] = [];
const pos = new Map<string, Node>();
let yCursor = yTop;
for (const ly of layerKeys) {
  const group = (layered.get(ly) as string[]).slice();
  if (ly === layerKeys[0]) {
    group.sort((a, b) => (globalIndex.get(a) as number) - (globalIndex.get(b) as number));
  } else {
    const bary = (id: string) => {
      const xs = prereqsOf(id).map((p) => pos.get(p)?.x).filter((v): v is number => v != null);
      return xs.length ? xs.reduce((s, v) => s + v, 0) / xs.length : cx;
    };
    group.sort((a, b) => bary(a) - bary(b) || (globalIndex.get(a) as number) - (globalIndex.get(b) as number));
  }
  const k = group.length;
  const cols = Math.min(k, maxCols);
  const rows = Math.ceil(k / cols);
  group.forEach((id, i) => {
    const l = byId.get(id)!;
    const r = Math.floor(i / cols);
    const rowStart = r * cols;
    const rowCount = Math.min(cols, k - rowStart);
    const c = i - rowStart;
    const node: Node = {
      id,
      title: l.data.title,
      order: l.data.order,
      label: l.data.label ?? String(l.data.order),
      layer: ly,
      x: Math.round(cx + (c - (rowCount - 1) / 2) * xGap),
      y: yCursor + r * rowGap,
      tier: l.data.tier,
      prereqs: prereqsOf(id),
    };
    nodes.push(node);
    pos.set(id, node);
  });
  yCursor += rows * rowGap + layerGap;
}
const edges = nodes.flatMap((n) => n.prereqs.map((p) => ({ from: pos.get(p)!, to: n })));
const VBH = yCursor - layerGap + 34;

// The key, grouped by tier, so numbers on the graph map back to titles.
const TIERS = [
  { id: 'basic', name: 'Basic' },
  { id: 'intermediate', name: 'Intermediate' },
  { id: 'expert', name: 'Expert' },
  { id: 'applied', name: 'Applied' },
];
const keyGroups = TIERS.map((t) => ({ name: t.name, items: lessons.filter((l) => l.data.tier === t.id) })).filter((g) => g.items.length);
---
<BaseLayout title="Concept map" active="map" totalLessons={lessons.length}>
  <section class="map-hero">
    <div class="eyebrow">The dependency graph</div>
    <h1>Concept map</h1>
    <p>How the lessons build on each other. An arrow means the lower lesson leans on the one above it. Finish a lesson and it fills in; once its prerequisites are done, the next one opens.</p>
  </section>

  <div class="cmap-legend">
    <span class="lg done"><i></i>Done</span>
    <span class="lg next"><i></i>Start next</span>
    <span class="lg open"><i></i>Open</span>
    <span class="lg locked"><i></i>Locked</span>
  </div>

  <p class="cmap-hint">Each circle is a lesson, numbered as in the list below. Arrows point from a prerequisite to the lesson that builds on it. Tap a circle to open it, or scroll the graph sideways to follow a track.</p>
  <div class="cmap-wrap">
    <svg viewBox={`0 0 ${VBW} ${VBH}`} width={VBW} height={VBH} class="cmap" role="img" aria-label="Prerequisite graph of the lessons">
      <g class="edges">
        {edges.map((e) => {
          const y1 = e.from.y + R, y2 = e.to.y - R, my = (y1 + y2) / 2;
          return <path d={`M ${e.from.x} ${y1} C ${e.from.x} ${my} ${e.to.x} ${my} ${e.to.x} ${y2}`} class="edge" data-to={e.to.id} data-from={e.from.id} />;
        })}
      </g>
      {nodes.map((n) => (
        <g
          class="cnode"
          data-href={withBase('lessons/' + n.id)}
          data-slug={n.id}
          data-order={n.order}
          data-seq={globalIndex.get(n.id)}
          data-prereqs={n.prereqs.join(',')}
        >
          <title>{n.title}</title>
          <circle cx={n.x} cy={n.y} r={R} class="disc" />
          <text x={n.x} y={n.y + 3.6} text-anchor="middle" class="num">{n.label}</text>
        </g>
      ))}
    </svg>
  </div>

  <div class="cmap-key">
    {keyGroups.map((g) => (
      <div class="kg">
        <div class="kglab">{g.name}</div>
        {g.items.map((l) => (
          <a class="ki" href={withBase('lessons/' + l.id)} data-slug={l.id}>
            <span class="kn mono">{l.data.label ?? l.data.order}</span>
            <span class="kt">{l.data.title}</span>
          </a>
        ))}
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .cmap-legend { display: flex; flex-wrap: wrap; gap: 14px; margin: 18px 0 6px; font-size: 11.5px; font-weight: 600; color: var(--ink-muted); }
  .lg { display: inline-flex; align-items: center; gap: 6px; }
  .lg i { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--border-strong); background: var(--surface); }
  .lg.done i { background: var(--accent); border-color: var(--accent); }
  .lg.next i { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .lg.locked i { opacity: .4; }

  .cmap-hint { font-size: 12.5px; line-height: 1.5; color: var(--ink-muted); margin: 6px 0 0; }
  .cmap-wrap { border: 1px solid var(--border); border-radius: 12px; padding: 10px; background: var(--surface); margin: 10px 0 4px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .cmap { height: auto; max-width: none; display: block; margin-inline: auto; }
  .edge { fill: none; stroke: var(--path); stroke-width: 1; opacity: .45; transition: opacity .2s, stroke .2s; }
  .cnode { cursor: pointer; }
  .cnode .disc { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1.5; transition: fill .2s, stroke .2s, stroke-width .2s; }
  .cnode .num { font-family: var(--font-mono); font-weight: 700; font-size: 12px; fill: var(--ink-muted); }
  .cnode:hover .disc { stroke: var(--accent); stroke-width: 2.5; }
  .cnode.complete .disc { fill: var(--accent); stroke: var(--accent); }
  .cnode.complete .num { fill: var(--bg); }
  .cnode.next .disc { stroke: var(--accent); stroke-width: 2.5; }
  .cnode.next .num { fill: var(--accent); }
  .cnode.locked { opacity: .42; }
  .cnode.locked .disc { stroke-dasharray: 3 2.5; }
  /* Highlight the edges into and out of the hovered lesson. */
  .edge.lit { opacity: .9; stroke: var(--accent); stroke-width: 1.6; }

  .cmap-key { margin: 20px 0 8px; }
  .kg { margin-bottom: 16px; }
  .kglab { font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .ki { display: flex; align-items: center; gap: 10px; padding: 6px 2px; text-decoration: none; color: var(--ink); border-radius: 8px; }
  .ki:hover { color: var(--accent); }
  .ki.done .kt { color: var(--ink-muted); text-decoration: line-through; text-decoration-color: var(--border-strong); }
  .kn { width: 26px; height: 26px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--border-strong); font-size: 10px; font-weight: 700; color: var(--ink-muted); }
  .ki.done .kn { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .kt { font-size: 14px; font-weight: 500; }
</style>

<script>
  import { load } from '@/lib/progress';

  function render() {
    const p = load();
    const done = (slug: string) => p.lessons[slug]?.status === 'complete';

    const nodes = Array.from(document.querySelectorAll<SVGGElement>('.cnode[data-slug]'));
    // "Start next" is the earliest lesson in curriculum order (data-seq) that is
    // unlocked and not yet done, independent of where it sits in the graph.
    let next: SVGGElement | null = null;
    let nextSeq = Infinity;
    for (const n of nodes) {
      const slug = n.dataset.slug as string;
      const prereqs = (n.dataset.prereqs || '').split(',').filter(Boolean);
      n.classList.remove('complete', 'next', 'locked', 'open');
      if (done(slug)) {
        n.classList.add('complete');
        continue;
      }
      if (!prereqs.every((pr) => done(pr))) {
        n.classList.add('locked');
        continue;
      }
      const seq = Number(n.dataset.seq);
      if (seq < nextSeq) {
        nextSeq = seq;
        next = n;
      }
    }
    if (next) next.classList.add('next');

    // Key list: strike through completed lessons.
    document.querySelectorAll<HTMLElement>('.ki[data-slug]').forEach((k) => {
      k.classList.toggle('done', done(k.dataset.slug as string));
    });
  }

  // The graph is a visual aid (the SVG is exposed to assistive tech as a
  // single labelled image); the accessible, keyboard-navigable path to every
  // lesson is the tier list below. Nodes navigate on click for mouse users.
  const edgePaths = Array.from(document.querySelectorAll<SVGPathElement>('.edge'));
  document.querySelectorAll<SVGGElement>('.cnode[data-href]').forEach((n) => {
    const href = n.dataset.href;
    const slug = n.dataset.slug;
    n.addEventListener('click', () => {
      if (href) window.location.href = href;
    });
    // Light up the lesson's own prerequisite edges (in and out) on hover.
    const lit = () => edgePaths.forEach((e) => {
      if (e.dataset.to === slug || e.dataset.from === slug) e.classList.add('lit');
    });
    const dim = () => edgePaths.forEach((e) => e.classList.remove('lit'));
    n.addEventListener('mouseenter', lit);
    n.addEventListener('mouseleave', dim);
  });

  // The graph is centered in its own canvas, so when it is wider than the
  // viewport open it scrolled to the middle rather than the empty left edge.
  const wrap = document.querySelector<HTMLElement>('.cmap-wrap');
  function centerGraph() {
    if (wrap) wrap.scrollLeft = Math.max(0, (wrap.scrollWidth - wrap.clientWidth) / 2);
  }
  centerGraph();
  window.addEventListener('resize', centerGraph);

  render();
  window.addEventListener('gt:progress', render);
  window.addEventListener('pageshow', render);
</script>
