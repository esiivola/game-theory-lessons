---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/config/site';

interface Props {
  slug: string;
  title: string;
  description?: string;
  totalLessons: number;
  nextHref?: string;
  nextTitle?: string;
}
const { slug, title, description, totalLessons, nextHref, nextTitle } = Astro.props;
---
<BaseLayout title={title} description={description} variant="lesson" lessonTitle={title} active="learn" totalLessons={totalLessons}>
  <article class="lesson" data-lesson={slug}>
    <slot />

    <div class="done-panel" id="donePanel" hidden>
      <div class="done-badge">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h2>Lesson complete</h2>
      <p>{nextTitle ? `Next up: ${nextTitle}.` : 'You have finished this lesson.'}</p>
      <div class="xp-chip">+30 XP</div>
      <div style="display:flex;gap:9px;justify-content:center;flex-wrap:wrap">
        {nextHref && <a class="btn" href={nextHref}>Next lesson</a>}
        <a class="btn ghost" href={withBase('')}>Back to map</a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import confetti from 'canvas-confetti';
  import { markSectionViewed, isComplete, tryCompleteLesson } from '@/lib/progress';

  const article = document.querySelector<HTMLElement>('.lesson[data-lesson]');
  const slug = article?.dataset.lesson;
  if (article && slug) {
    const lessonSlug = slug;

    function lockPredictionAnswer(details: HTMLDetailsElement) {
      if (details.dataset.predictionBound) return;
      details.dataset.predictionBound = 'true';
      details.setAttribute('data-prediction-ready', 'false');
      const summary = details.querySelector('summary');
      if (!summary) return;
      const readyLabel = summary.textContent ?? 'Compare with your prediction';
      summary.textContent = 'Play once to compare';
      summary.setAttribute('aria-disabled', 'true');
      summary.addEventListener('click', (event) => {
        if (details.dataset.predictionReady === 'false') event.preventDefault();
      });
      details.addEventListener('toggle', () => {
        if (details.open && details.dataset.predictionReady === 'false') details.open = false;
      });
      details.addEventListener('gt:prediction-ready', () => {
        details.setAttribute('data-prediction-ready', 'true');
        summary.textContent = readyLabel;
        summary.removeAttribute('aria-disabled');
      });
    }

    function bindPredictionAnswers(root: ParentNode) {
      root.querySelectorAll<HTMLDetailsElement>('.prediction-answer').forEach(lockPredictionAnswer);
    }

    function pathHasClass(event: Event, name: string) {
      return event.composedPath().some(
        (node) => node instanceof HTMLElement && node.classList.contains(name),
      );
    }

    function unlockPrediction(event: Event) {
      const target = event.target as HTMLElement | null;
      if (!target || target.closest('.prediction-answer') || target.closest('.predict')) return;
      if (event.type === 'click' && !target.closest('button, a, [role="button"]')) return;
      if (event.type === 'click' && /^(reset|replay|clear|start over)/i.test(target.textContent?.trim() ?? '')) return;
      if (pathHasClass(event, 'predict') || pathHasClass(event, 'prediction-answer')) return;
      const widget = event.composedPath().find(
        (node): node is HTMLElement => node instanceof HTMLElement && node.classList.contains('widget'),
      );
      widget?.querySelectorAll<HTMLDetailsElement>('.prediction-answer[data-prediction-ready="false"]')
        .forEach((details) => details.dispatchEvent(new CustomEvent('gt:prediction-ready')));
    }

    bindPredictionAnswers(article);
    new MutationObserver((records) => {
      records.forEach((record) => record.addedNodes.forEach((node) => {
        if (node instanceof HTMLElement) {
          if (node.matches('.prediction-answer')) lockPredictionAnswer(node as HTMLDetailsElement);
          bindPredictionAnswers(node);
        }
      }));
    }).observe(article, { childList: true, subtree: true });
    article.addEventListener('click', unlockPrediction);
    article.addEventListener('input', unlockPrediction);

    // Track sections as they scroll into view. A section counts once its top edge has
    // crossed into the top 80% of the viewport, matching the old IntersectionObserver's
    // rootMargin. This used to run off IntersectionObserver, then off a 'scroll' listener;
    // both are event-driven, and both turned out to be able to miss a section the user had
    // genuinely scrolled past, silently and permanently blocking completion with no error
    // and no recovery path. IntersectionObserver's callback is dispatched async and can be
    // coalesced by the browser on a fast scroll. 'scroll' itself is not guaranteed either:
    // some mobile browsers (notably iOS Safari during an inertial flick) dispatch it sparsely
    // rather than continuously, so a quick thumb-flick can move the page across a section
    // between two 'scroll' events and never fire one while that section was in the 0.8 band.
    // A plain rAF poll has no such gap: the browser must paint a frame for every visible
    // change of scroll position, so checking geometry once per painted frame cannot skip a
    // position the page actually rendered at, regardless of which input or browser drove it.
    const sections = [...article.querySelectorAll<HTMLElement>('[data-section]')];
    const unseen = new Set(sections);

    function pollSections() {
      if (unseen.size === 0) return;
      for (const s of unseen) {
        if (s.getBoundingClientRect().top < window.innerHeight * 0.8) {
          unseen.delete(s);
          if (s.dataset.section) markSectionViewed(lessonSlug, s.dataset.section);
        }
      }
      if (unseen.size > 0) requestAnimationFrame(pollSections);
    }
    pollSections();

    const sectionIds = [...sections].flatMap((section) => section.dataset.section ? [section.dataset.section] : []);
    const quizIds = [...article.querySelectorAll<HTMLElement>('[data-quiz]')]
      .flatMap((quiz) => quiz.dataset.quiz ? [quiz.dataset.quiz] : []);
    let finished = isComplete(lessonSlug);
    let reconciling = false;

    function reveal(celebrate: boolean) {
      const panel = document.getElementById('donePanel');
      if (panel) panel.hidden = false;
      if (celebrate) {
        const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!rm) {
          try { confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } }); } catch {}
        }
        const t = document.getElementById('toast');
        if (t) {
          t.textContent = 'Lesson complete';
          t.classList.add('show');
          setTimeout(() => t.classList.remove('show'), 2600);
        }
        panel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    if (finished) reveal(false);

    function reconcileCompletion() {
      if (!finished && !reconciling && quizIds.length > 0) {
        reconciling = true;
        const result = tryCompleteLesson(lessonSlug, sectionIds, quizIds);
        reconciling = false;
        if (!result.complete) return;
        finished = true;
        reveal(result.firstTime);
      }
    }

    reconcileCompletion();
    window.addEventListener('gt:progress', reconcileCompletion);
  }
</script>
