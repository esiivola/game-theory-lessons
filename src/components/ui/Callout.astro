---
interface Props {
  kind?: 'key-idea' | 'ask' | 'reality-check';
  label?: string;
}
const { kind = 'key-idea', label } = Astro.props;
const chev = '<svg class="caret" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
---
{kind === 'key-idea' && (
  <div class="keyidea"><div class="lab">{label ?? 'Key idea'}</div><p><slot /></p></div>
)}
{kind === 'ask' && (
  <details class="callout-ask">
    <summary><Fragment set:html={chev} />{label ?? 'Take a guess, then reveal the reason'}</summary>
    <div class="body"><slot /></div>
  </details>
)}
{kind === 'reality-check' && (
  <div class="reality-check"><div class="lab">{label ?? 'Reality check'}</div><p><slot /></p></div>
)}
