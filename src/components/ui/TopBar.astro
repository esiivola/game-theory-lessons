---
import { withBase, siteConfig } from '@/config/site';
interface Props {
  variant?: 'brand' | 'lesson';
  lessonTitle?: string;
  totalLessons?: number;
}
const { variant = 'brand', lessonTitle = '', totalLessons = 0 } = Astro.props;
---
<header class="topbar">
  {variant === 'lesson' ? (
    <>
      <a class="backbtn" href={withBase('')} aria-label="Back to lessons">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 class="lesson-title-top">{lessonTitle}</h1>
    </>
  ) : (
    <a class="brandmark" href={withBase('')}>
      <span class="dot" aria-hidden="true"></span>
      <b>{siteConfig.title}</b>
    </a>
  )}
  <div class="spacer"></div>
  <span class="prog-pill" id="topProg" data-total={totalLessons} hidden>
    <span id="topRing"></span> <span class="mono" id="topFrac"></span>
  </span>
  <button class="theme-toggle" id="themeToggle" aria-label="Switch theme" title="Switch theme">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</header>
